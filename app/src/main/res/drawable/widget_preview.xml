<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#CC6750A4" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- Clock icon representation -->
    <item
        android:gravity="center"
        android:width="48dp"
        android:height="48dp">
        <vector
            android:width="48dp"
            android:height="48dp"
            android:viewportWidth="24"
            android:viewportHeight="24">
            <!-- Clock circle -->
            <path
                android:fillColor="#00000000"
                android:strokeColor="#FFFFFF"
                android:strokeWidth="2"
                android:pathData="M12,12m-9,0a9,9 0,1 1,18 0a9,9 0,1 1,-18 0"/>
            <!-- Hour hand -->
            <path
                android:strokeColor="#FFFFFF"
                android:strokeWidth="2"
                android:strokeLineCap="round"
                android:pathData="M12,12L12,7"/>
            <!-- Minute hand -->
            <path
                android:strokeColor="#FFFFFF"
                android:strokeWidth="2"
                android:strokeLineCap="round"
                android:pathData="M12,12L16,12"/>
            <!-- Center dot -->
            <path
                android:fillColor="#FFFFFF"
                android:pathData="M12,12m-1.5,0a1.5,1.5 0,1 1,3 0a1.5,1.5 0,1 1,-3 0"/>
        </vector>
    </item>
</layer-list>
